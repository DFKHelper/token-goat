<!-- HAND-DERIVED: standard Salesforce Aura component markup written from language knowledge, not from any adapter regex. -->
<aura:component controller="ItemController">
    <aura:attribute name="itemName" type="String" default=""/>
    <aura:attribute name="quantity" type="Integer" default="0"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    <div class="item-card">
        <p>{!v.itemName}: {!v.quantity}</p>
    </div>
</aura:component>
