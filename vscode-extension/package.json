{
  "name": "token-goat-vscode",
  "displayName": "token-goat",
  "description": "Send compressed selections and surgical file reads to VS Code chat.",
  "version": "0.1.0",
  "publisher": "dfkhelper",
  "icon": "icon.png",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DFKHelper/token-goat.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "icon.png",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "token-goat.sendSelection",
        "title": "Send Selection to Chat (Compressed)",
        "category": "token-goat",
        "icon": "$(send)"
      },
      {
        "command": "token-goat.sendSurgicalRead",
        "title": "Send Lines Around Cursor to Chat (Compressed)",
        "category": "token-goat",
        "icon": "$(go-to-file)"
      },
      {
        "command": "token-goat.sendSymbol",
        "title": "Send Symbol at Cursor to Chat (Compressed)",
        "category": "token-goat",
        "icon": "$(symbol-function)"
      },
      {
        "command": "token-goat.sendFile",
        "title": "Send Whole File to Chat (Compressed)",
        "category": "token-goat",
        "icon": "$(file)"
      },
      {
        "command": "token-goat.sendDiff",
        "title": "Send Git Diff to Chat (Compressed)",
        "category": "token-goat",
        "icon": "$(diff)"
      }
    ],
    "configuration": {
      "title": "token-goat",
      "properties": {
        "token-goat.contextLines": {
          "type": "number",
          "default": 25,
          "minimum": 5,
          "maximum": 200,
          "description": "Lines above and below the cursor included by 'Send Lines Around Cursor'."
        },
        "token-goat.showStats": {
          "type": "boolean",
          "default": true,
          "description": "Show a status-bar message with the compression savings after each send."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "token-goat.sendSelection",
          "when": "editorHasSelection",
          "group": "token-goat@1"
        },
        {
          "command": "token-goat.sendSurgicalRead",
          "when": "editorTextFocus",
          "group": "token-goat@2"
        },
        {
          "command": "token-goat.sendSymbol",
          "when": "editorTextFocus",
          "group": "token-goat@3"
        },
        {
          "command": "token-goat.sendFile",
          "when": "editorTextFocus",
          "group": "token-goat@4"
        }
      ],
      "explorer/context": [
        {
          "command": "token-goat.sendFile",
          "when": "!explorerResourceIsFolder",
          "group": "token-goat@1"
        }
      ],
      "editor/title": [
        {
          "command": "token-goat.sendSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        },
        {
          "command": "token-goat.sendSurgicalRead",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "token-goat-vscode.tokenGoat",
        "name": "token-goat",
        "description": "Compress your selection or the lines around your cursor so chat costs fewer tokens.",
        "isSticky": true,
        "commands": [
          {
            "name": "selection",
            "description": "Compress the current editor selection and reply with the payload."
          },
          {
            "name": "context",
            "description": "Compress the lines around the cursor and reply with the payload."
          },
          {
            "name": "symbol",
            "description": "Send the full body of the symbol under the cursor, compressed."
          },
          {
            "name": "file",
            "description": "Compress the whole active file and reply with the payload."
          },
          {
            "name": "diff",
            "description": "Compress the workspace's git diff (against HEAD) and reply with the payload."
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.7.0"
  }
}
